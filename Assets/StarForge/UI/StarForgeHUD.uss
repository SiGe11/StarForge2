/* The Host's look (docs/lore, section 6: the iron, the old Host grey under the paint; capes
   trimmed in bronze and gold): grey iron panels, bronze edges, gilt for headings and news,
   ember for trouble. The wing's blue (--accent) stays for what the player points at and
   selects. Headings are set in Cinzel (OFL 1.1, THIRD-PARTY.md), body text in Inter. */
:root {
    --accent: #4fd1ff;
    --accent-dim: rgba(79, 209, 255, 0.35);
    --accent-faint: rgba(79, 209, 255, 0.12);
    --amber: #ffb547;
    --danger: #ff5a4f;
    --ok: #59e38c;
    --text: #e4e2da;
    --muted: #9c988e;
    --panel: rgba(15, 15, 17, 0.86);
    --panel-edge: rgba(201, 164, 98, 0.30);
    --screen-dim: rgba(3, 6, 10, 0.72);
    --radius: 3px;
    --gilt: #ddb86e;
    --gilt-dim: rgba(221, 184, 110, 0.45);
    --gilt-faint: rgba(221, 184, 110, 0.12);
    --bronze: rgba(176, 129, 74, 0.55);
    --ember: #eb5e42;
}

.root {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Inter-Regular.ttf");
    color: var(--text);
    font-size: 15px;
}

/* ------------------------------------------------------------ shared */
.panel {
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--panel-edge);
    border-radius: var(--radius);
    padding: 10px;
}

.section-title {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--gilt);
    margin-top: 10px;
    margin-bottom: 4px;
}

/* The menus' layer (StarForgeMenu.uxml): over the HUD, under the cheat's mark. */
.menu-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ------------------------------------------------------------ HUD */
.hud {
    flex-grow: 1;
    justify-content: space-between;
}

.screen-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 42px;
    padding: 0 14px;
    background-color: var(--panel);
    border-bottom-width: 1px;
    border-color: var(--panel-edge);
}

.resource {
    flex-direction: row;
    align-items: center;
    margin-right: 26px;
}

.resource-icon {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    border-radius: 3px;
    rotate: 45deg;
}

.resource-icon--ore {
    background-color: #62e0ff;
    border-width: 1px;
    border-color: #d8f8ff;
}

.resource-icon--supply {
    background-color: var(--amber);
    border-radius: 7px;
    rotate: 0deg;
}

.resource-value {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    font-size: 18px;
    min-width: 70px;
}

.resource-value--warn {
    color: var(--danger);
}

.clock {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    color: var(--muted);
    font-size: 16px;
}

.top-bar-spacer {
    flex-grow: 1;
}

.intel {
    color: var(--muted);
    font-size: 13px;
    margin-right: 18px;
}

.perf {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    color: rgba(142, 163, 182, 0.7);
    font-size: 12px;
    margin-right: 12px;
}

.top-button {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Bold.ttf");
    border-radius: 2px;
    border-width: 1px;
    margin: 4px;
    color: var(--text);
    letter-spacing: 1.5px;
    transition-duration: 0.12s;
    background-color: rgba(255, 255, 255, 0.03);
    border-color: var(--bronze);
    font-size: 12px;
    padding: 5px 12px;
}

.top-button:hover {
    background-color: var(--accent-faint);
    border-color: var(--accent-dim);
}

.top-button--active {
    border-color: var(--accent);
    color: var(--accent);
}

.alerts {
    position: absolute;
    top: 58px;
    left: 0;
    right: 0;
    align-items: center;
}

/* A dispatch (HUDController.UX): an SFFrame (cut corners, hairline edge, a tab in its colour,
   painted in code) with the star as its seal, a heading in Cinzel and the text. Gilt for
   news (alert--good), ember for trouble (alert--warn), ash for a refusal, the wing's blue
   for the interface's own hints. "TAB" marks one with a place to go to. */
.dispatch {
    flex-direction: row;
    align-items: center;
    min-width: 260px;
    max-width: 640px;
    padding: 6px 14px 7px 12px;
    margin-bottom: 6px;
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.35s;
}

.dispatch--new {
    opacity: 0;
    translate: 0 -6px;
}

.dispatch--fading {
    opacity: 0;
    translate: 0 -10px;
}

.dispatch-star {
    width: 14px;
    height: 14px;
    margin-right: 11px;
    flex-shrink: 0;
}

.dispatch-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.dispatch-head {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--gilt);
    margin-bottom: 1px;
}

.dispatch-text {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 15px;
    color: var(--text);
    white-space: normal;
}

.alert--warn .dispatch-head { color: #f29a82; }
.alert--warn .dispatch-text { color: #ffe0d6; }
.alert--good .dispatch-text { color: #f3ead6; }
.alert--refused { min-width: 0; padding: 4px 12px 5px 10px; }
.alert--refused .dispatch-text { font-size: 14px; color: #d8d4ca; }
.alert--refused .dispatch-star { width: 10px; height: 10px; margin-right: 8px; }
.alert--hint { min-width: 0; padding: 4px 12px 5px 10px; }
.alert--hint .dispatch-text { font-size: 14px; color: #cfeefd; }
.alert--hint .dispatch-star { width: 10px; height: 10px; margin-right: 8px; }

.dispatch-key {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-left: 14px;
    padding: 1px 5px 1px 5px;
    border-width: 1px;
    border-radius: 2px;
    border-color: rgba(156, 152, 142, 0.45);
    flex-shrink: 0;
}

/* ------------------------------------------------------------ the Mech: status strip and comms */
.comms {
    position: absolute;
    top: 52px;
    left: 10px;
    width: 430px;
}

.mech-strip {
    background-color: var(--panel);
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--panel-edge);
    border-left-color: var(--gilt);
    border-radius: var(--radius);
    padding: 7px 10px 8px 10px;
    margin-bottom: 8px;
    display: none;
}

.mech-strip--visible {
    display: flex;
}

.mech-strip:hover {
    background-color: rgba(28, 26, 24, 0.94);
}

.mech-strip-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.mech-strip-name {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

/* The knight's order: its standard's device, set by HUDController (View/OrderStandards). Hidden until there is one. */
.mech-strip-device {
    width: 18px;
    height: 18px;
    margin-right: 7px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--panel-edge);
    -unity-background-scale-mode: stretch-to-fill;   /* the sprite is the banner's square, squeezed in the atlas */
    display: none;
}

.mech-strip-device--shown {
    display: flex;
}

.mech-strip-title {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--gilt);
}

.mech-strip-state {
    font-size: 12px;
    color: var(--muted);
}

.mech-strip-bar {
    height: 7px;
    margin-top: 5px;
}

.mech-strip-bar--shield {
    height: 3px;
    margin-top: 2px;
}

.mech-strip-text {
    font-size: 13px;
    color: var(--text);
    margin-top: 4px;
    white-space: normal;
}

.comms-feed {
    flex-direction: column;
}

/* The knight on the field net: iron, a bronze hairline, the call's colour down the left. */
.comms-line {
    background-color: rgba(15, 15, 17, 0.88);
    border-width: 1px;
    border-left-width: 3px;
    border-color: rgba(201, 164, 98, 0.26);
    border-left-color: var(--gilt);
    border-radius: 2px;
    padding: 6px 10px 7px 10px;
    margin-bottom: 6px;
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.4s;
}

.comms-line:hover {
    background-color: rgba(30, 28, 25, 0.96);
}

.comms-line--new {
    opacity: 0;
    translate: -24px 0;
}

.comms-line--fading {
    opacity: 0;
}

.comms-line--attack { border-left-color: var(--ember); }
.comms-line--defend { border-left-color: var(--gilt); }
.comms-line--regroup { border-left-color: #b39ad8; }
.comms-line--warning { border-left-color: var(--ember); }
.comms-line--morale { border-left-color: rgba(221, 184, 110, 0.6); }
.comms-line--status { border-left-color: #9fb7c9; }

.comms-who {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--gilt);
}

.comms-text {
    font-size: 14px;
    color: var(--text);
    white-space: normal;
    margin-top: 2px;
}

.comms-hint {
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
}

.comms-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* What kind of message it is: a suggestion to act on, a warning, a report. */
.comms-tag {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 10px;
    letter-spacing: 1.2px;
    padding: 1px 5px 1px 5px;
    margin-left: 8px;
    border-radius: 2px;
    color: #171209;
    background-color: var(--gilt);
}

/* Like wax on a dispatch: ember for an attack or a warning, gilt to defend. */
.comms-tag--attack { background-color: #c94a33; color: #fff1e6; }
.comms-tag--warning { background-color: #c94a33; color: #fff1e6; }
.comms-tag--defend { background-color: var(--gilt); }
.comms-tag--regroup { background-color: #b39ad8; }
.comms-tag--status { background-color: rgba(159, 183, 201, 0.18); color: #c4d6e3; }

/* Flavour: the Mech talking, not advising -- quieter, lighter, untagged. */
.comms-line--flair {
    background-color: rgba(15, 15, 17, 0.55);
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(221, 184, 110, 0.40);
    padding: 3px 10px 4px 10px;
}

.comms-line--flair .comms-who {
    font-size: 10px;
    color: var(--muted);
}

.bottom-bar {
    flex-direction: row;
    align-items: flex-end;
    padding: 10px;
}

.minimap-frame {
    width: 250px;
    height: 250px;
    padding: 4px;
}

.minimap {
    flex-grow: 1;
    overflow: hidden;
    border-radius: 3px;
}

.minimap-image,
.minimap-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The selection and, on it, the control groups (HUDController.UX): the bar's 36 px fit in the
   room the taller minimap and command card leave above the panel. */
.selection-column {
    flex-grow: 1;
    margin: 0 10px;
}

.selection-panel {
    height: 170px;
    justify-content: center;
}

.group-bar {
    flex-direction: row;
    align-items: flex-end;
    height: 36px;
    margin-bottom: 5px;
}

.group-tab,
.idle-tab {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 6px 0 4px;
    margin-right: 4px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--panel-edge);
    border-radius: 2px;
    transition-duration: 0.1s;
    display: none;
}

.group-tab--shown,
.idle-tab--shown {
    display: flex;
}

.group-tab:hover,
.idle-tab:hover {
    border-color: var(--accent);
    background-color: rgba(24, 30, 34, 0.92);
}

/* The selection is this group. */
.group-tab--active {
    border-color: var(--gilt);
    border-top-width: 2px;
    background-color: rgba(42, 36, 26, 0.92);
}

.group-tab-key {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    color: var(--gilt);
    margin-right: 3px;
    -unity-text-align: upper-left;
}

.group-tab-icon {
    width: 24px;
    height: 24px;
}

.group-tab-count {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    font-size: 13px;
    color: var(--text);
    margin-left: 3px;
}

/* The idle Diggers (F1): first on the bar, in the field's warning amber. */
.idle-tab {
    border-color: rgba(255, 181, 71, 0.55);
    margin-right: 12px;
}

.idle-tab-word {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Bold.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--amber);
    margin-left: 3px;
}

.single-info {
    flex-direction: row;
    align-items: center;
    display: none;
}

.single-info--visible {
    display: flex;
}

.portrait {
    width: 132px;
    height: 132px;
    background-color: rgba(79, 209, 255, 0.06);
    border-width: 1px;
    border-color: var(--accent-faint);
    border-radius: 4px;
    margin-right: 16px;
}

.single-text {
    flex-grow: 1;
}

.unit-name {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Regular.ttf");
    font-size: 20px;
    letter-spacing: 1px;
    color: #f4efe4;
}

.unit-stats {
    color: var(--muted);
    font-size: 13px;
    margin-top: 2px;
}

.hp-bar {
    height: 12px;
    margin-top: 8px;
    margin-bottom: 6px;
    max-width: 420px;
}

.unit-status {
    color: var(--accent);
    font-size: 14px;
}

.queue {
    flex-direction: row;
    margin-top: 8px;
}

.queue-slot {
    width: 42px;
    height: 42px;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

.queue-slot--active {
    border-color: var(--accent);
}

.queue-progress {
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    height: 4px;
}

.multi-grid {
    flex-direction: row;
    flex-wrap: wrap;
    display: none;
}

.multi-grid--visible {
    display: flex;
}

.unit-tile {
    width: 50px;
    height: 58px;
    margin: 2px;
    padding: 2px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 3px;
    transition-duration: 0.1s;
}

.unit-tile:hover {
    border-color: var(--accent);
    background-color: var(--accent-faint);
}

.unit-tile-icon {
    flex-grow: 1;
}

.unit-tile-bar {
    height: 5px;
}

.selection-hint {
    color: var(--muted);
    -unity-text-align: middle-center;
    font-size: 14px;
}

.command-card {
    /* Four 70 px slots a row and the padding: at 290 only three fitted, and a twelve-card
       card ran a row past the panel. */
    width: 296px;
    height: 230px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 6px;
}

.card-button {
    width: 64px;
    height: 64px;
    margin: 3px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(201, 164, 98, 0.24);
    border-radius: 2px;
    transition-duration: 0.1s;
}

.card-button:hover {
    border-color: var(--accent);
    background-color: var(--accent-faint);
    scale: 1.04 1.04;
}

.card-button--disabled {
    opacity: 0.42;
}

.card-button--empty {
    opacity: 0;
}

.card-icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
}

.card-glyph {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: var(--text);
}

.card-hotkey {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    position: absolute;
    left: 4px;
    top: 2px;
    font-size: 13px;
    color: var(--amber);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.card-cost {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    position: absolute;
    right: 4px;
    bottom: 2px;
    font-size: 12px;
    color: #9be9ff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.tooltip {
    position: absolute;
    right: 12px;
    bottom: 256px;
    width: 300px;
    padding: 10px 12px;
    background-color: rgba(13, 13, 15, 0.96);
    border-width: 1px;
    border-color: var(--panel-edge);
    border-top-color: var(--gilt-dim);
    border-radius: 2px;
    display: none;
}

.tooltip--visible {
    display: flex;
}

.tooltip-title {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Cinzel-Regular.ttf");
    font-size: 16px;
    color: #f4efe4;
}

.tooltip-cost {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    font-size: 13px;
    color: var(--amber);
    margin-top: 2px;
}

.tooltip-body {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
    margin-top: 6px;
}

.inspector {
    position: absolute;
    top: 52px;
    right: 10px;
    width: 380px;
    display: none;
}

.inspector--visible {
    display: flex;
}

.insp-strategy {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Inter-SemiBold.ttf");
    font-size: 22px;
    color: var(--amber);
}

.insp-reason {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

.chart {
    margin-bottom: 4px;
}

.chart-row {
    flex-direction: row;
    align-items: center;
    height: 19px;
}

.chart-row--hidden {
    display: none;
}

.chart-label {
    width: 118px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.chart-bar {
    flex-grow: 1;
    height: 8px;
    margin: 0 8px;
}

.chart-value {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    width: 56px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: var(--muted);
    -unity-text-align: middle-right;
}

.chart-row--highlight > .chart-label,
.chart-row--highlight > .chart-value {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--amber);
}

.chart-row--locked > .chart-label,
.chart-row--locked > .chart-value {
    color: rgba(142, 163, 182, 0.45);
}

.insp-stats {
    -unity-font: url("project://database/Assets/StarForge/UI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    color: var(--muted);
    margin-top: 10px;
    white-space: normal;
}

/* The cheat's mark: over everything, the end screen included, and it never goes away. */
.cheat-label {
    position: absolute;
    top: 46px;
    right: 14px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #ff3a30;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.cheat-label--reckoning {
    font-size: 46px;
}
